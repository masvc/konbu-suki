{
  "$comment": "夜間の自動記事作成（scripts/auto-content.ts）が claude -p に渡す権限設定の雛形。このファイルを auto-settings.json にコピーして使う。auto-settings.json は gitignore 対象（機種ごとに変えられるようにするため）。-p では都度の確認ができないので、許可していない操作は黙って拒否される。deny は allow より強い。なお $? や ${PIPESTATUS[0]} のような置換を混ぜたコマンドは、allow に並べても拒否される。1コマンドずつ素の形で実行させる（プロンプト側にも書いてある）。",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch",
      "TodoWrite",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git pull --ff-only)",
      "Bash(npm run build)",
      "Bash(npm run lint)",
      "Bash(npm run typecheck:scripts)",
      "Bash(npx tsx scripts/generate-guide-images.ts:*)",
      "Bash(npx tsx scripts/meta-check.ts:*)",
      "Bash(npx tsx scripts/site-check.ts:*)",
      "Bash(npm run images:optimize:*)",
      "Bash(echo:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(sed -n:*)",
      "Bash(grep:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(head:*)",
      "Bash(tail:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Edit(./.env)",
      "Edit(./.env.*)",
      "Read(./google-credentials.json)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(rm:*)",
      "Bash(npm run db:seed)",
      "Bash(npm run db:migrate)",
      "Bash(npm run env:push:*)",
      "Bash(npx prisma:*)",
      "Bash(npx tsx prisma/seed.ts:*)",
      "Bash(npx tsx scripts/match-rakuten.ts:*)",
      "Bash(npx tsx scripts/fetch-rakuten-kombu.ts:*)",
      "Bash(npx tsx scripts/fetch-amazon-kombu.ts:*)",
      "Bash(npx tsx scripts/add-product.ts:*)",
      "Bash(npx tsx scripts/env-sync.ts:*)"
    ]
  }
}
